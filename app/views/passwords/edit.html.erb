<% content_for :title, "Update your password" %>

<div class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-2xl font-semibold text-slate-900">Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <%= render layout: "shared/field", locals: { form: form, attribute: :password, label: "New password" } do |field| %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, **field %>
    <% end %>

    <%= render layout: "shared/field", locals: { form: form, attribute: :password_confirmation, label: "Repeat new password" } do |field| %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, **field %>
    <% end %>

    <div class="flex items-center gap-4">
      <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    </div>
  <% end %>
</div>
