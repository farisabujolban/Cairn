<% content_for :title, @task.title %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= back_link_to "Tasks", project_story_tasks_path(@project, @story) %>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @task.title %></h1>
    <div class="flex items-center gap-2">
      <%# Each control asks the policy for its own action rather than sharing one
          role check, so the two can diverge later without the view lying. %>
      <% if policy(@task).edit? %>
        <%= link_to "Edit", edit_project_task_path(@project, @task),
              class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100" %>
      <% end %>
      <% if policy(@task).destroy? %>
        <%= button_to "Delete", project_task_path(@project, @task), method: :delete,
              form: { data: { turbo_confirm: "Delete this task?" } },
              class: "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-red-300 hover:bg-red-50 hover:text-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-4 flex flex-wrap gap-6 text-sm text-slate-600">
    <div>
      <dt class="font-medium text-slate-900">Story</dt>
      <dd><%= link_to @story.title, project_story_path(@project, @story), class: "font-medium text-slate-900 transition-colors hover:text-slate-600" %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Status</dt>
      <dd><%= @task.status.titleize %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Assignee</dt>
      <dd><%= @task.assignee&.name || "Unassigned" %></dd>
    </div>
  </dl>
</div>
