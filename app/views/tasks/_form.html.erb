<%= form_with model: task, url: form_url, class: "mt-6 space-y-4" do |form| %>
  <% if task.errors.any? %>
    <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
      <h2><%= pluralize(task.errors.count, "error") %> prevented this task from being saved:</h2>
      <ul class="mt-2 list-disc pl-5">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-slate-900" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :status, class: "block text-sm font-medium text-slate-900" %>
    <%= form.select :status, Task::STATUSES.map { |status| [ status.titleize, status ] },
          {}, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :assignee_id, "Assignee", class: "block text-sm font-medium text-slate-900" %>
    <%# Only this project's members are offered; the model rejects anyone else. %>
    <%= form.collection_select :assignee_id, project.users.order(:name), :id, :name,
          { include_blank: "Unassigned" }, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: "cursor-pointer rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    <%# Cancel, not a back link: one way out, and it lands where the form was opened from. %>
    <%= link_to "Cancel", cancel_path, class: "text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" %>
  </div>
<% end %>
