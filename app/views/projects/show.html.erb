<% content_for :title, @project.name %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= link_to "← All projects", projects_path, class: "text-sm text-slate-600 hover:underline" %>

  <div class="mt-4 flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @project.name %></h1>
    <%= link_to "Edit", edit_project_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>

  <p class="mt-2 text-slate-600"><%= @project.description %></p>

  <nav class="mt-6 flex gap-3 border-t border-slate-200 pt-6 text-sm">
    <%= link_to "Milestones", project_milestones_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" %>
  </nav>
</div>
