<% content_for :title, @project.name %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= back_link_to "All projects", projects_path %>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @project.name %></h1>
    <%= link_to "Edit", edit_project_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100" %>
  </div>

  <p class="mt-2 text-slate-600"><%= @project.description %></p>

  <nav class="mt-6 flex flex-wrap gap-3 border-t border-slate-200 pt-6 text-sm">
    <%= link_to "Epics", project_epics_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" %>
    <%= link_to "Milestones", project_milestones_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" %>
    <%# Offered to every role: the roster is readable by anyone on the project,
        and this page is the only way to reach it. %>
    <%= link_to "Members", project_memberships_path(@project),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" %>
  </nav>
</div>
