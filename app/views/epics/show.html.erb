<% content_for :title, @epic.title %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= back_link_to "Epics", project_epics_path(@project) %>

  <div class="mt-4 flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @epic.title %></h1>
    <div class="flex items-center gap-2">
      <%# Each control asks the policy for its own action rather than sharing one
          role check, so the two can diverge later without the view lying. %>
      <% if policy(@epic).edit? %>
        <%= link_to "Edit", edit_project_epic_path(@project, @epic),
              class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100" %>
      <% end %>
      <% if policy(@epic).destroy? %>
        <%= button_to "Delete", project_epic_path(@project, @epic), method: :delete,
              form: { data: { turbo_confirm: "Delete this epic?" } },
              class: "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-red-300 hover:bg-red-50 hover:text-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-4 flex gap-6 text-sm text-slate-600">
    <div>
      <dt class="font-medium text-slate-900">Status</dt>
      <dd><%= @epic.status.titleize %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Milestone</dt>
      <dd>
        <% if @epic.milestone %>
          <%= link_to @epic.milestone.title, project_milestone_path(@project, @epic.milestone), class: "font-medium text-slate-900 transition-colors hover:text-slate-600" %>
        <% else %>
          Unscheduled
        <% end %>
      </dd>
    </div>
  </dl>

  <p class="mt-4 text-slate-600"><%= @epic.description %></p>

  <%= render "shared/progress", progress: @epic.progress, unit: "stories" %>

  <nav class="mt-6 flex gap-3 border-t border-slate-200 pt-6 text-sm">
    <%# The only way into this epic's stories: containment is the navigation. %>
    <%= link_to project_epic_stories_path(@project, @epic),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" do %>
      Stories <span class="text-slate-500">(<%= @epic.stories.size %>)</span>
    <% end %>
  </nav>
</div>
