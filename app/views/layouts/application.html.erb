<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cairn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cairn">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <%# WCAG 2.4.1, and the first element in the body because that is the
          whole of the job: a skip link the first Tab does not reach has already
          failed. Hidden until focused, so it costs sighted users nothing.
          Rendered only alongside the header — on the sign-in page there is no
          navigation to skip, and a link offering to skip nothing is a keyboard
          stop that saves nobody anything.

          data-turbo="false" is load-bearing, not caution. Turbo Drive
          intercepts the fragment link and scrolls the page itself, which skips
          the browser step that moves focus to the target — so the link looks
          like it works, and the next Tab goes straight back to the nav it was
          supposed to skip past. Handing the link back to the browser is what
          makes the jump real. A system test pins it. %>
      <%= link_to "Skip to main content", "#main", data: { turbo: false },
            class: "sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white" %>

      <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
          <%= link_to "Cairn", root_path, class: "font-semibold text-slate-900" %>
          <div class="flex items-center gap-3 text-sm text-slate-600">
            <span><%= Current.user.name %></span>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "cursor-pointer rounded-md border border-slate-300 px-2 py-1 transition-colors hover:bg-slate-100 hover:border-slate-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
          </div>
        </nav>
      </header>
    <% end %>

    <% if flash.any? %>
      <div class="mx-auto max-w-3xl px-4 pt-4">
        <% flash.each do |type, message| %>
          <p class="rounded-md border px-4 py-2 text-sm <%= type.to_s == "alert" ? "border-red-300 bg-red-50 text-red-800" : "border-green-300 bg-green-50 text-green-800" %>">
            <%= message %>
          </p>
        <% end %>
      </div>
    <% end %>

    <%# The skip link's target. tabindex="-1" is what makes the jump actually
        move focus: without it the browser scrolls to the landmark and leaves
        focus behind on the link, so the next Tab returns to the nav. %>
    <main id="main" tabindex="-1">
      <%= yield %>
    </main>

    <%# §7's back-to-top button. Rendered hidden and revealed by its controller
        past a scroll threshold, so it costs nothing on a short page. It sits
        outside <main> deliberately: it is a control for the page, not part of
        the content, and putting it inside would place it in the region the
        skip link jumps to. %>
    <% if authenticated? %>
      <button type="button" hidden
              data-testid="back-to-top"
              data-controller="back-to-top"
              data-action="click->back-to-top#scrollToTop"
              class="fixed bottom-6 right-6 z-40 cursor-pointer rounded-full border border-slate-300 bg-white p-3 text-slate-700 shadow-sm transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">
        <span aria-hidden="true" class="block leading-none">↑</span>
        <span class="sr-only">Back to top</span>
      </button>
    <% end %>
  </body>
</html>
