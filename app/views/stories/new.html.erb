<% content_for :title, "New story" %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="text-2xl font-semibold text-slate-900">New story</h1>
  <p class="mt-1 text-sm text-slate-600">In <%= @epic.title %></p>
  <%= render "form", project: @project, story: @story,
        form_url: project_epic_stories_path(@project, @epic),
        cancel_path: project_epic_stories_path(@project, @epic) %>
</div>
