<% content_for :title, @story.title %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= back_link_to "Stories", project_epic_stories_path(@project, @epic) %>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @story.title %></h1>
    <div class="flex items-center gap-2">
      <%# Each control asks the policy for its own action rather than sharing one
          role check, so the two can diverge later without the view lying. %>
      <% if policy(@story).edit? %>
        <%= link_to "Edit", edit_project_story_path(@project, @story),
              class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100" %>
      <% end %>
      <% if policy(@story).destroy? %>
        <%= button_to "Delete", project_story_path(@project, @story), method: :delete,
              form: { data: { turbo_confirm: "Delete this story?" } },
              class: "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-red-300 hover:bg-red-50 hover:text-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-4 flex flex-wrap gap-6 text-sm text-slate-600">
    <div>
      <dt class="font-medium text-slate-900">Epic</dt>
      <dd><%= link_to @epic.title, project_epic_path(@project, @epic), class: "font-medium text-slate-900 transition-colors hover:text-slate-600" %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Status</dt>
      <dd><%= @story.status.titleize %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Milestone</dt>
      <dd>
        <% if @story.milestone %>
          <%= link_to @story.milestone.title, project_milestone_path(@project, @story.milestone), class: "font-medium text-slate-900 transition-colors hover:text-slate-600" %>
        <% else %>
          Unscheduled
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">Assignee</dt>
      <dd><%= @story.assignee&.name || "Unassigned" %></dd>
    </div>
  </dl>

  <p class="mt-4 text-slate-600"><%= @story.description %></p>

  <%= render "shared/progress", progress: @story.progress, unit: "tasks" %>

  <nav class="mt-6 flex gap-3 border-t border-slate-200 pt-6 text-sm">
    <%# The only way into this story's tasks: containment is the navigation. %>
    <%= link_to project_story_tasks_path(@project, @story),
          class: "rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" do %>
      Tasks <span class="text-slate-500">(<%= @story.tasks.size %>)</span>
    <% end %>
  </nav>
</div>
