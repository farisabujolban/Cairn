<% content_for :title, @milestone.title %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <%= back_link_to "Milestones", project_milestones_path(@project) %>

  <div class="mt-4 flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900"><%= @milestone.title %></h1>
    <div class="flex items-center gap-2">
      <%# Each control asks the policy for its own action rather than sharing one
          role check, so the two can diverge later without the view lying. %>
      <% if policy(@milestone).edit? %>
        <%= link_to "Edit", edit_project_milestone_path(@project, @milestone),
              class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100" %>
      <% end %>
      <% if policy(@milestone).destroy? %>
        <%= button_to "Delete", project_milestone_path(@project, @milestone), method: :delete,
              form: { data: { turbo_confirm: "Delete this milestone?" } },
              class: "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-red-300 hover:bg-red-50 hover:text-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-4 flex gap-6 text-sm text-slate-600">
    <div>
      <dt class="font-medium text-slate-900">Due</dt>
      <dd><%= @milestone.due_on ? l(@milestone.due_on, format: :long) : "No date" %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900">State</dt>
      <dd><%= @milestone.state.titleize %></dd>
    </div>
  </dl>

  <%= render "shared/progress", progress: @milestone.progress, unit: "stories", empty: "No stories scheduled" %>

  <p class="mt-4 text-slate-600"><%= @milestone.description %></p>
</div>
